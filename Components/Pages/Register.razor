@page "/account/register"

<h1>Register</h1>
@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<form method="post" action="/account/register-submit">
    <div class="mb-3">
        <label class="form-label" for="fullName">Full name</label>
        <input id="fullName" name="fullName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input id="email" name="email" class="form-control" type="email" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="role">Account role</label>
        <select id="role" name="role" class="form-select" onchange="togglePsychologistProfile()">
            <option>Patient</option>
            <option>Psychologist</option>
        </select>
    </div>
    <div id="psychologistProfile" class="border rounded p-3 mb-3 d-none">
        <h2 class="h5">Psychologist profile</h2>
        <div class="mb-3">
            <label class="form-label" for="specialty">Specialty</label>
            <input id="specialty" name="specialty" class="form-control" placeholder="Anxiety, couples therapy, general support..." />
        </div>
        <div class="mb-3">
            <label class="form-label">Available days</label>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var day in days)
                {
                    <label class="form-check-label"><input class="form-check-input me-1" type="checkbox" name="availableDays" value="@day" /> @day</label>
                }
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="availableFrom">From</label>
                <input id="availableFrom" name="availableFrom" class="form-control" type="time" value="09:00" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="availableTo">To</label>
                <input id="availableTo" name="availableTo" class="form-control" type="time" value="17:00" />
            </div>
        </div>
        <div class="mt-3">
            <label class="form-label" for="bio">Short bio</label>
            <textarea id="bio" name="bio" class="form-control" rows="3"></textarea>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input id="password" name="password" class="form-control" type="password" minlength="6" required />
    </div>
    <button class="btn btn-primary" type="submit">Create account</button>
</form>

<script>
    function togglePsychologistProfile() {
        const role = document.getElementById('role')?.value;
        document.getElementById('psychologistProfile')?.classList.toggle('d-none', role !== 'Psychologist');
    }

    togglePsychologistProfile();
</script>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    readonly string[] days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
}
