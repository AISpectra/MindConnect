@page "/account/login"

<h1>Login</h1>
@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<form method="post" action="@LoginAction">
    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input id="email" name="email" class="form-control" type="email" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input id="password" name="password" class="form-control" type="password" required />
    </div>
    <button class="btn btn-primary" type="submit">Login</button>
    <p class="mt-3 text-muted">Demo: demo@mindconnect.local / Password1</p>
</form>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    string LoginAction => string.IsNullOrWhiteSpace(ReturnUrl)
        ? "/account/login-submit"
        : $"/account/login-submit?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
}
