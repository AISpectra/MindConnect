@page "/"
@inject NavigationManager Nav

<PageTitle>MindConnect</PageTitle>

<section class="hero rounded-4 p-5 mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <h1 class="display-5 fw-bold">Calm, simple appointment support for mental wellness.</h1>
            <p class="lead">MindConnect helps patients schedule and manage appointments with psychologists in a secure Blazor Server application.</p>
            <a class="btn btn-primary btn-lg me-2" href="/account/register">Get started</a>
            <a class="btn btn-outline-primary btn-lg" href="/account/login">Login</a>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Appointment support</h2>
                    <ul>
                        <li>Find psychologists by availability</li>
                        <li>Schedule sessions within open hours</li>
                        <li>Manage upcoming and past appointments</li>
                        <li>Use separate patient and psychologist views</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
