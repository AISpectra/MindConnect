@page "/appointments/{Id:int}"
@attribute [Authorize]
@inject AppointmentService Service
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav
<h1>Appointment Details</h1>@if(error is not null){<div class="alert alert-danger">@error</div>}@if(a is null){<p class="alert alert-warning">Appointment not found or you do not have access.</p>}else{<div class="card"><div class="card-body"><h2 class="h4">@a.PsychologistName</h2><p><strong>Patient:</strong> @a.PatientName</p><p><strong>When:</strong> @a.AppointmentDate at @a.AppointmentTime</p><p><strong>Status:</strong> @a.Status</p><p><strong>Reason:</strong> @a.Reason</p><p><strong>Notes:</strong> @(a.Notes ?? "None")</p><p><strong>Created:</strong> @a.CreatedAt.ToLocalTime()</p><a class="btn btn-outline-primary" href="/appointments/edit/@a.Id">Edit</a><button class="btn btn-outline-warning ms-2" @onclick="Cancel">Cancel appointment</button><button class="btn btn-outline-danger ms-2" @onclick="Delete">Delete</button></div></div>}
@code{[Parameter] public int Id{get;set;} Appointment? a; string? uid; string? error; protected override async Task OnInitializedAsync(){var s=await Auth.GetAuthenticationStateAsync(); uid=s.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value!; a=await Service.GetByIdAsync(Id,uid);} async Task Cancel(){if(a is null)return; try{a.Status=AppointmentStatus.Cancelled; await Service.UpdateAsync(a); Nav.NavigateTo("/appointments");}catch(Exception){error="We could not cancel this appointment.";}} async Task Delete(){if(a is null)return; try{await Service.DeleteAsync(a); Nav.NavigateTo("/appointments");}catch(Exception){error="We could not delete this appointment.";}}}
