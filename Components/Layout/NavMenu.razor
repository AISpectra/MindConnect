@inject NavigationManager Navigation

<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold text-teal" href="/">MindConnect</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="nav" class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><NavLink class="nav-link" href="/dashboard">Dashboard</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="/appointments">Appointments</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="/appointments/create">Schedule</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="/history">History</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="/psychologists">Psychologists</NavLink></li>
            </ul>
            <AuthorizeView>
                <Authorized>
                    <span class="navbar-text me-3">Hello, @context.User.Identity?.Name</span>
                    <form method="post" action="/account/logout"><button class="btn btn-outline-secondary btn-sm">Logout</button></form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-primary btn-sm me-2" href="/account/login">Login</a>
                    <a class="btn btn-primary btn-sm" href="/account/register">Register</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>
